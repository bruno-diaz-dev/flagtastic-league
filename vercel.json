{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview": true,
      "expand-team-audit": true,
      "chore/vercel-storage-optimization": true,
      "fix/vercel-fast-origin-transfer": true
    }
  },
  "functions": {
    "main.py": {
      "excludeFiles": "{tests/**,docs/**,.github/**,migrations/**,scripts/**,README.md,Dockerfile,.dockerignore,alembic.ini,pytest.ini,requirements-dev.txt,.env.example}"
    }
  },
  "headers": [
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
