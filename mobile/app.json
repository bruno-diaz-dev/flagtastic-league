{
  "expo": {
    "name": "Flagtastic League",
    "slug": "flagtastic-league-mobile",
    "description": "Resultados, posiciones y estadísticas personales de Flagtastic Football League.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "flagtastic",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#041329",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flagtastic.league",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#041329",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.flagtastic.league",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#041329"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://flagtastic.online"
    }
  }
}
