DATABASE_URL=postgresql://flagtastic:flagtastic@localhost:5432/flagtastic
TEST_DATABASE_URL=postgresql://flagtastic:flagtastic@localhost:5432/flagtastic_test
# Local HTTP development only. Production keeps the default value: true.
SESSION_COOKIE_SECURE=false

# Observability. Leave SENTRY_DSN unset to disable remote telemetry locally.
APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Vercel supplies VERCEL_GIT_COMMIT_SHA automatically in deployments.
SENTRY_RELEASE=
